<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>อุจิฮะ ยูซึรุ - นิยาย</title>

<style>

/* =========================================================
   BASIC
   ========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family:
        "Noto Sans Thai",
        "Segoe UI",
        Arial,
        sans-serif;

    background:
        linear-gradient(
            rgba(15, 18, 25, 0.94),
            rgba(15, 18, 25, 0.97)
        );

    color: #eeeeee;
    min-height: 100vh;
}


/* =========================================================
   HEADER
   ========================================================= */

.header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(20, 23, 30, 0.96);
    border-bottom: 1px solid #3b3f48;

    backdrop-filter: blur(10px);
}

.header-inner {
    max-width: 1100px;
    margin: auto;
    padding: 16px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-symbol {
    width: 42px;
    height: 42px;

    border-radius: 50%;

    background: #15171d;
    border: 2px solid #9a2020;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 20px;
}

.logo-text {
    line-height: 1.2;
}

.logo-title {
    font-size: 18px;
    font-weight: bold;
}

.logo-subtitle {
    font-size: 12px;
    color: #9ea4af;
}


/* =========================================================
   MAIN
   ========================================================= */

.container {
    max-width: 1100px;
    margin: auto;
    padding: 30px 20px 80px;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
    text-align: center;
    padding: 35px 20px 30px;
}

.hero h1 {
    margin: 0;

    font-size: clamp(28px, 5vw, 46px);
    letter-spacing: 1px;
}

.hero p {
    margin: 10px 0 0;

    color: #aeb4bf;
    font-size: 15px;
}


/* =========================================================
   FILE CONTROL
   ========================================================= */

.file-panel {
    background: #1c1f26;

    border: 1px solid #363a44;
    border-radius: 14px;

    padding: 18px;

    margin-bottom: 25px;
}

.file-panel-title {
    font-size: 14px;
    font-weight: bold;

    margin-bottom: 12px;
}

.file-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

button,
select {
    font-family: inherit;
}

button {
    border: 1px solid #454a55;

    background: #272b34;
    color: #eeeeee;

    padding: 10px 16px;

    border-radius: 8px;

    cursor: pointer;

    transition:
        background 0.2s,
        transform 0.1s,
        border-color 0.2s;
}

button:hover {
    background: #333844;
    border-color: #666d7b;
}

button:active {
    transform: scale(0.98);
}

button.primary {
    background: #7d1d1d;
    border-color: #9d2929;
}

button.primary:hover {
    background: #982525;
}

button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

.file-status {
    margin-top: 12px;

    color: #9ea4af;
    font-size: 13px;

    min-height: 20px;
}


/* =========================================================
   CHAPTER SELECTOR
   ========================================================= */

.chapter-panel {
    background: #1c1f26;

    border: 1px solid #363a44;
    border-radius: 14px;

    padding: 18px;

    margin-bottom: 25px;
}

.chapter-row {
    display: flex;
    gap: 10px;
    align-items: center;
}

.chapter-select {
    flex: 1;

    background: #272b34;
    color: #eeeeee;

    border: 1px solid #454a55;

    padding: 11px 14px;

    border-radius: 8px;

    outline: none;
}

.chapter-select:focus {
    border-color: #777f8e;
}


/* =========================================================
   STORY
   ========================================================= */

.story-card {
    background: #191c22;

    border: 1px solid #363a44;
    border-radius: 16px;

    overflow: hidden;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.25);
}

.story-header {
    padding: 25px 28px 18px;

    border-bottom: 1px solid #30343d;
}

.story-chapter {
    color: #a32929;

    font-size: 13px;
    font-weight: bold;

    margin-bottom: 6px;
}

.story-title {
    margin: 0;

    font-size: clamp(24px, 4vw, 34px);
}

.story-content {
    padding: 30px;

    font-size: 18px;
    line-height: 2;

    white-space: pre-wrap;

    color: #eeeeee;

    min-height: 400px;
}

.story-content.empty {
    color: #858b96;
    text-align: center;

    padding-top: 100px;
}


/* =========================================================
   READING CONTROLS
   ========================================================= */

.reading-controls {
    display: flex;
    flex-wrap: wrap;

    gap: 10px;

    padding: 18px 25px;

    border-top: 1px solid #30343d;
    border-bottom: 1px solid #30343d;

    background: #171a20;
}

.control-group {
    display: flex;
    align-items: center;
    gap: 8px;
}

.control-label {
    color: #9ea4af;
    font-size: 13px;
}

.speed-select {
    background: #272b34;
    color: #eeeeee;

    border: 1px solid #454a55;

    padding: 8px 10px;

    border-radius: 7px;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.navigation {
    display: flex;
    justify-content: space-between;
    gap: 15px;

    padding: 20px 25px;
}

.navigation button {
    min-width: 130px;
}


/* =========================================================
   PROGRESS
   ========================================================= */

.progress-panel {
    padding: 0 25px 22px;
}

.progress-info {
    display: flex;
    justify-content: space-between;

    color: #8f96a2;

    font-size: 12px;

    margin-bottom: 7px;
}

.progress-bar {
    width: 100%;
    height: 6px;

    background: #30343d;

    border-radius: 20px;

    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0%;

    background: #8f2424;

    transition: width 0.3s;
}


/* =========================================================
   SETTINGS
   ========================================================= */

.settings {
    margin-top: 25px;

    background: #1c1f26;

    border: 1px solid #363a44;

    border-radius: 14px;

    padding: 20px;
}

.settings-title {
    font-size: 15px;
    font-weight: bold;

    margin-bottom: 15px;
}

.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 10px 0;

    border-bottom: 1px solid #2c3038;
}

.setting-row:last-child {
    border-bottom: none;
}

.setting-name {
    font-size: 14px;
}

.setting-description {
    color: #858c98;
    font-size: 12px;

    margin-top: 3px;
}


/* =========================================================
   TOGGLE
   ========================================================= */

.switch {
    position: relative;

    width: 46px;
    height: 24px;
}

.switch input {
    display: none;
}

.slider {
    position: absolute;

    inset: 0;

    background: #3b3f48;

    border-radius: 30px;

    cursor: pointer;

    transition: 0.2s;
}

.slider:before {
    content: "";

    position: absolute;

    width: 18px;
    height: 18px;

    left: 3px;
    top: 3px;

    background: #ffffff;

    border-radius: 50%;

    transition: 0.2s;
}

.switch input:checked + .slider {
    background: #8f2424;
}

.switch input:checked + .slider:before {
    transform: translateX(22px);
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
    text-align: center;

    color: #686f7b;

    font-size: 12px;

    padding: 30px 20px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

    .header-inner {
        padding: 12px 15px;
    }

    .logo-subtitle {
        display: none;
    }

    .container {
        padding: 20px 12px 60px;
    }

    .hero {
        padding: 25px 10px;
    }

    .chapter-row {
        flex-direction: column;
        align-items: stretch;
    }

    .story-header {
        padding: 20px;
    }

    .story-content {
        padding: 22px 20px;

        font-size: 17px;
        line-height: 1.9;
    }

    .reading-controls {
        padding: 15px 20px;
    }

    .navigation {
        padding: 15px 20px;
    }

    .navigation button {
        min-width: 0;
        flex: 1;
    }

}


/* =========================================================
   READING MODE
   ========================================================= */

body.reading-mode .header,
body.reading-mode .hero,
body.reading-mode .file-panel,
body.reading-mode .chapter-panel,
body.reading-mode .settings,
body.reading-mode .footer {

