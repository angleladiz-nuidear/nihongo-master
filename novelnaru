<script>

/* =========================================================
   UCHIHA YUZURU
   AUDIO NOVEL SYSTEM
   ========================================================= */


/* =========================================================
   VARIABLES
   ========================================================= */

let chapterFolder = null;

let chapters = [];

let currentChapterIndex = -1;

let currentText = "";

let speechQueue = [];

let speechIndex = 0;

let isSpeaking = false;

let isPaused = false;


/* =========================================================
   ELEMENTS
   ========================================================= */

const selectFolderButton =
    document.getElementById("selectFolderButton");

const resetFolderButton =
    document.getElementById("resetFolderButton");

const fileStatus =
    document.getElementById("fileStatus");

const chapterSelect =
    document.getElementById("chapterSelect");

const loadChapterButton =
    document.getElementById("loadChapterButton");

const storyChapter =
    document.getElementById("storyChapter");

const storyTitle =
    document.getElementById("storyTitle");

const storyContent =
    document.getElementById("storyContent");

const playButton =
    document.getElementById("playButton");

const pauseButton =
    document.getElementById("pauseButton");

const resumeButton =
    document.getElementById("resumeButton");

const stopButton =
    document.getElementById("stopButton");

const previousButton =
    document.getElementById("previousButton");

const nextButton =
    document.getElementById("nextButton");

const speedSelect =
    document.getElementById("speedSelect");

const voiceSelect =
    document.getElementById("voiceSelect");

let availableVoices = [];

const progressFill =
    document.getElementById("progressFill");

const progressText =
    document.getElementById("progressText");

const autoNext =
    document.getElementById("autoNext");

const focusMode =
    document.getElementById("focusMode");

const rememberChapter =
    document.getElementById("rememberChapter");

const readingModeButton =
    document.getElementById("readingModeButton");


/* =========================================================
   SELECT FOLDER
   ========================================================= */

selectFolderButton.addEventListener(
    "click",
    async () => {

        if (!window.showDirectoryPicker) {

            fileStatus.textContent =
                "เบราว์เซอร์นี้ไม่รองรับการเลือกโฟลเดอร์โดยตรง กรุณาใช้ Google Chrome หรือ Microsoft Edge";

            return;
        }

        try {

            const folder =
                await window.showDirectoryPicker();

            chapterFolder = folder;

            fileStatus.textContent =
                "กำลังค้นหาไฟล์ Chapter...";

            await scanChapterFolder();

        } catch (error) {

            console.log(error);

            fileStatus.textContent =
                "ยกเลิกการเลือกโฟลเดอร์";

        }

    }
);


/* =========================================================
   SCAN CHAPTER FOLDER
   ========================================================= */

async function scanChapterFolder() {

    chapters = [];

    for await (
        const [name, handle]
        of chapterFolder.entries()
    ) {

        if (
            handle.kind === "file" &&
            /^chapter\d+\.txt$/i.test(name)
        ) {

            const match =
                name.match(/chapter(\d+)\.txt/i);

            const number =
                parseInt(match[1], 10);

            chapters.push({
                number: number,
                name: name,
                handle: handle
            });

        }

    }


    chapters.sort(
        (a, b) => a.number - b.number
    );


    chapterSelect.innerHTML = "";


    if (chapters.length === 0) {

        const option =
            document.createElement("option");

        option.value = "";

        option.textContent =
            "ไม่พบไฟล์ Chapter";

        chapterSelect.appendChild(option);

        fileStatus.textContent =
            "ไม่พบ chapter01.txt, chapter02.txt หรือไฟล์ Chapter ที่มีรูปแบบถูกต้อง";

        return;
    }


    chapters.forEach(
        (chapter, index) => {

            const option =
                document.createElement("option");

            option.value = index;

            option.textContent =
                `บทที่ ${chapter.number}`;

            chapterSelect.appendChild(option);

        }
    );


    fileStatus.textContent =
        `พบทั้งหมด ${chapters.length} บท`;

    
    const savedChapter =
        localStorage.getItem(
            "yuzuru_last_chapter"
        );


    if (
        rememberChapter.checked &&
        savedChapter !== null
    ) {

        const savedIndex =
            chapters.findIndex(
                chapter =>
                    chapter.number ===
                    parseInt(savedChapter, 10)
            );


        if (savedIndex >= 0) {

            chapterSelect.value =
                savedIndex;

            await loadChapter(savedIndex);

            return;
        }

    }


    chapterSelect.value = 0;

    await loadChapter(0);

}


/* =========================================================
   LOAD CHAPTER
   ========================================================= */

loadChapterButton.addEventListener(
    "click",
    async () => {

        const index =
            parseInt(
                chapterSelect.value,
                10
            );

        if (Number.isNaN(index)) {
            return;
        }

        await loadChapter(index);

    }
);


async function loadChapter(index) {

    if (
        !chapters[index] ||
        !chapterFolder
    ) {
        return;
    }


    stopSpeech();


    currentChapterIndex = index;


    const chapter =
        chapters[index];


    try {

        const file =
            await chapter.handle.getFile();

        currentText =
            await file.text();


        displayChapter(
            chapter,
            currentText
        );


        if (rememberChapter.checked) {

            localStorage.setItem(
                "yuzuru_last_chapter",
                chapter.number
            );

        }


        chapterSelect.value =
            index;


        updateNavigation();


    } catch (error) {

        console.error(error);

        storyContent.textContent =
            "ไม่สามารถอ่านไฟล์ Chapter ได้";

    }

}


/* =========================================================
   DISPLAY CHAPTER
   ========================================================= */

function displayChapter(
    chapter,
    text
) {

    storyChapter.textContent =
        `บทที่ ${chapter.number}`;


    let title =
        extractTitle(text);


    storyTitle.textContent =
        title ||
        `บทที่ ${chapter.number}`;


    storyContent.classList.remove(
        "empty"
    );


    storyContent.textContent =
        cleanStoryText(text);


    updateProgress(0);


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}


/* =========================================================
   EXTRACT TITLE
   ========================================================= */

function extractTitle(text) {

    const lines =
        text
            .split(/\r?\n/)
            .map(line => line.trim())
            .filter(line => line.length > 0);


    if (lines.length === 0) {
        return "";
    }


    const firstLine =
        lines[0];


    if (
        /^บทที่\s*\d+/i.test(firstLine)
    ) {

        if (lines.length > 1) {

            return lines[1]
                .replace(
                    /^[-—:：]\s*/,
                    ""
                )
                .trim();

        }

        return firstLine;
    }


    return firstLine;

}


/* =========================================================
   CLEAN STORY TEXT
   ========================================================= */

function cleanStoryText(text) {

    return text
        .replace(
            /^\uFEFF/,
            ""
        )
        .trim();

}


/* =========================================================
   CHAPTER NAVIGATION
   ========================================================= */

previousButton.addEventListener(
    "click",
    async () => {

        if (
            currentChapterIndex <= 0
        ) {
            return;
        }

        await loadChapter(
            currentChapterIndex - 1
        );

    }
);


nextButton.addEventListener(
    "click",
    async () => {

        if (
            currentChapterIndex <
            chapters.length - 1
        ) {

            await loadChapter(
                currentChapterIndex + 1
            );

        }

    }
);


function updateNavigation() {

    previousButton.disabled =
        currentChapterIndex <= 0;


    nextButton.disabled =
        currentChapterIndex >=
        chapters.length - 1;

}


/* =========================================================
   TEXT TO SPEECH
   ========================================================= */

playButton.addEventListener(
    "click",
    () => {

        if (!currentText) {
            return;
        }

        startSpeech();

    }
);


pauseButton.addEventListener(
    "click",
    () => {

        if (
            speechSynthesis.speaking &&
            !speechSynthesis.paused
        ) {

            speechSynthesis.pause();

            isPaused = true;

        }

    }
);


resumeButton.addEventListener(
    "click",
    () => {

        if (
            speechSynthesis.paused
        ) {

            speechSynthesis.resume();

            isPaused = false;

        }

    }
);


stopButton.addEventListener(
    "click",
    () => {

        stopSpeech();

    }
);


/* =========================================================
   START SPEECH
   ========================================================= */

function startSpeech() {

    stopSpeech();


    const text =
        cleanStoryText(
            currentText
        );


    speechQueue =
        splitTextForSpeech(text);


    speechIndex = 0;

    isSpeaking = true;

    isPaused = false;

    speakNextPart();

}


/* =========================================================
   SPLIT TEXT
   ========================================================= */

function splitTextForSpeech(text) {

    // เดิมโค้ดนี้รวมทั้งย่อหน้าให้ยาวถึง 700 ตัวอักษรต่อประโยคเสียง
    // ซึ่งทำให้เอนจิน TTS ของเบราว์เซอร์ค้าง/หยุดกลางคันได้บ่อย
    // จึงตัดเป็นท่อนสั้นลง โดยพยายามตัดตรงจุดหยุดตามธรรมชาติ
    // (จุลภาค มหัพภาค ฯลฯ) เพื่อให้เสียงลื่นไหลและฟังเป็นธรรมชาติกว่าเดิม

    const MAX_CHUNK_LENGTH = 220;
    const MIN_CHUNK_LENGTH = 60;
    const PAUSE_PUNCTUATION = /[,.!?…”"ๆฯ]$/;

    const paragraphs =
        text
            .split(/\n+/)
            .map(paragraph => paragraph.trim())
            .filter(paragraph => paragraph.length > 0);

    const result = [];

    for (const paragraph of paragraphs) {

        const words =
            paragraph
                .split(/\s+/)
                .filter(Boolean);

        let buffer = "";

        for (const word of words) {

            if (word.length > MAX_CHUNK_LENGTH) {

                if (buffer) {
                    result.push(buffer);
                    buffer = "";
                }

                let remaining = word;

                while (remaining.length > MAX_CHUNK_LENGTH) {
                    result.push(remaining.slice(0, MAX_CHUNK_LENGTH));
                    remaining = remaining.slice(MAX_CHUNK_LENGTH);
                }

                buffer = remaining;
                continue;

            }

            const candidate =
                buffer
                    ? buffer + " " + word
                    : word;

            if (candidate.length > MAX_CHUNK_LENGTH && buffer) {
                result.push(buffer);
                buffer = word;
            } else {
                buffer = candidate;
            }

            if (
                buffer.length >= MIN_CHUNK_LENGTH &&
                PAUSE_PUNCTUATION.test(word)
            ) {
                result.push(buffer);
                buffer = "";
            }

        }

        if (buffer) {
            result.push(buffer);
        }

    }

    return result;

}


/* =========================================================
   SPEAK NEXT PART
   ========================================================= */

function speakNextPart() {

    if (!isSpeaking) {
        return;
    }


    if (
        speechIndex >=
        speechQueue.length
    ) {

        finishSpeech();

        return;

    }


    const text =
        speechQueue[
            speechIndex
        ];


    const utterance =
        new SpeechSynthesisUtterance(
            text
        );


    utterance.lang =
        "th-TH";


    utterance.rate =
        parseFloat(
            speedSelect.value
        );


    utterance.pitch =
        0.95;


    utterance.volume =
        1;


    const selectedVoice =
        availableVoices.find(
            voice =>
                voice.voiceURI ===
                voiceSelect.value
        );

    if (selectedVoice) {
        utterance.voice =
            selectedVoice;
    }


    utterance.onstart =
        () => {

            updateProgress(
                speechIndex /
                speechQueue.length
                * 100
            );

        };


    utterance.onend =
        () => {

            if (!isSpeaking) {
                return;
            }

            speechIndex++;

            updateProgress(
                speechIndex /
                speechQueue.length
                * 100
            );

            setTimeout(
                speakNextPart,
                100
            );

        };


    utterance.onerror =
        error => {

            console.error(
                "Speech error:",
                error
            );

            isSpeaking = false;

        };


    speechSynthesis.speak(
        utterance
    );

}


/* =========================================================
   FINISH SPEECH
   ========================================================= */

function finishSpeech() {

    isSpeaking = false;

    isPaused = false;

    updateProgress(100);


    if (
        autoNext.checked &&
        currentChapterIndex <
        chapters.length - 1
    ) {

        setTimeout(
            async () => {

                await loadChapter(
                    currentChapterIndex + 1
                );

                setTimeout(
                    startSpeech,
                    500
                );

            },
            800
        );

    }

}


/* =========================================================
   STOP SPEECH
   ========================================================= */

function stopSpeech() {

    speechSynthesis.cancel();

    isSpeaking = false;

    isPaused = false;

    speechQueue = [];

    speechIndex = 0;

}


/* =========================================================
   PROGRESS
   ========================================================= */

function updateProgress(percent) {

    const safePercent =
        Math.max(
            0,
            Math.min(
                100,
                percent
            )
        );


    progressFill.style.width =
        `${safePercent}%`;


    progressText.textContent =
        `${Math.round(
            safePercent
        )}%`;

}


/* =========================================================
   SPEED
   ========================================================= */

speedSelect.addEventListener(
    "change",
    () => {

        if (
            speechSynthesis.speaking
        ) {

            speechSynthesis.cancel();

            isSpeaking = false;

            setTimeout(
                startSpeech,
                100
            );

        }

    }
);


/* =========================================================
   READING MODE
   ========================================================= */

readingModeButton.addEventListener(
    "click",
    () => {

        document.body.classList.toggle(
            "reading-mode"
        );


        if (
            document.body.classList.contains(
                "reading-mode"
            )
        ) {

            readingModeButton.textContent =
                "ออกจากโหมดอ่าน";

        } else {

            readingModeButton.textContent =
                "โหมดอ่าน";

        }

    }
);


/* =========================================================
   FOCUS MODE
   ========================================================= */

focusMode.addEventListener(
    "change",
    () => {

        document.body.classList.toggle(
            "focus-mode",
            focusMode.checked
        );

    }
);


/* =========================================================
   RESET FOLDER
   ========================================================= */

resetFolderButton.addEventListener(
    "click",
    () => {

        stopSpeech();

        chapterFolder = null;

        chapters = [];

        currentChapterIndex = -1;

        currentText = "";

        chapterSelect.innerHTML =
            `<option value="">
                ยังไม่ได้โหลด Chapter
             </option>`;


        storyChapter.textContent =
            "ยังไม่ได้เลือกบท";


        storyTitle.textContent =
            "อุจิฮะ ยูซึรุ";


        storyContent.textContent =
            "กรุณาเลือกโฟลเดอร์ Chapter แล้วเลือกบทที่ต้องการอ่าน";


        storyContent.classList.add(
            "empty"
        );


        fileStatus.textContent =
            "กรุณาเลือกโฟลเดอร์ chapter เพื่อเริ่มต้น";


        updateProgress(0);

    }
);


/* =========================================================
   KEYBOARD SHORTCUTS
   ========================================================= */

document.addEventListener(
    "keydown",
    event => {

        if (
            event.target.tagName ===
            "SELECT"
        ) {
            return;
        }


        if (
            event.code ===
            "Space"
        ) {

            event.preventDefault();


            if (
                speechSynthesis.speaking &&
                !speechSynthesis.paused
            ) {

                speechSynthesis.pause();

                isPaused = true;

            } else if (
                speechSynthesis.paused
            ) {

                speechSynthesis.resume();

                isPaused = false;

            } else {

                startSpeech();

            }

        }


        if (
            event.code ===
            "ArrowRight"
        ) {

            nextButton.click();

        }


        if (
            event.code ===
            "ArrowLeft"
        ) {

            previousButton.click();

        }

    }
);


/* =========================================================
   LOAD VOICES
   ========================================================= */

function loadVoices() {

    availableVoices =
        speechSynthesis.getVoices();

    if (availableVoices.length === 0) {
        return;
    }

    const thaiVoices =
        availableVoices.filter(
            voice =>
                voice.lang &&
                voice.lang
                    .toLowerCase()
                    .startsWith("th")
        );

    // ถ้าพบเสียงภาษาไทย ให้แสดงเฉพาะเสียงเหล่านั้นก่อน
    // (มักจะฟังเป็นธรรมชาติกว่าเสียงระบบทั่วไปที่ไม่รองรับภาษาไทยโดยตรง)
    const listedVoices =
        thaiVoices.length > 0
            ? thaiVoices
            : availableVoices;

    const previouslySelected =
        voiceSelect.value ||
        localStorage.getItem(
            "novelReaderVoiceURI"
        );

    voiceSelect.innerHTML = "";

    listedVoices.forEach(voice => {

        const option =
            document.createElement("option");

        option.value = voice.voiceURI;

        option.textContent =
            voice.name +
            (voice.lang ? ` (${voice.lang})` : "");

        voiceSelect.appendChild(option);

    });

    // เลือก Google/เสียงคุณภาพสูงเป็นค่าเริ่มต้นถ้ามี เพราะมักฟังลื่นไหล
    // เป็นธรรมชาติกว่าเสียงสังเคราะห์พื้นฐานของระบบปฏิบัติการ
    const preferredVoice =
        listedVoices.find(
            voice =>
                voice.voiceURI === previouslySelected
        ) ||
        listedVoices.find(
            voice =>
                /google/i.test(voice.name)
        ) ||
        listedVoices[0];

    if (preferredVoice) {
        voiceSelect.value =
            preferredVoice.voiceURI;
    }

}

speechSynthesis.onvoiceschanged = loadVoices;

loadVoices();

voiceSelect.addEventListener(
    "change",
    () => {

        localStorage.setItem(
            "novelReaderVoiceURI",
            voiceSelect.value
        );

        if (speechSynthesis.speaking) {
            speechSynthesis.cancel();
            isSpeaking = false;
            setTimeout(startSpeech, 100);
        }

    }
);


/* =========================================================
   INITIAL STATE
   ========================================================= */

updateNavigation();

updateProgress(0);


/* =========================================================
   CHECK SPEECH SUPPORT
   ========================================================= */

if (
    !("speechSynthesis" in window)
) {

    fileStatus.textContent =
        "เบราว์เซอร์นี้ไม่รองรับระบบอ่านออกเสียง";

}


/* =========================================================
   END
   ========================================================= */

</script>

