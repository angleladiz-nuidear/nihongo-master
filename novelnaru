}

body.reading-mode .container {
    max-width: 900px;
    padding-top: 30px;
}

body.reading-mode .story-content {
    font-size: 21px;
    line-height: 2.15;
}


/* =========================================================
   DARK READING FOCUS
   ========================================================= */

body.focus-mode {
    background: #08090b;
}

body.focus-mode .story-card {
    border-color: #24272d;
}

</style>
</head>


